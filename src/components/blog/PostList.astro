---
import type { CollectionEntry } from "astro:content";
import ExternalIcon from "@/components/blog/ExternalIcon.astro";
import { getPostHref, getPostSortDate } from "@/data/post";
import { formatRailDate } from "@/utils/date";

interface Props {
	posts: CollectionEntry<"post">[];
	/** Seeds the `--i` stagger-animation index (e.g. when rows follow a featured post). */
	startIndex?: number;
	/** Heading tag for each post title. */
  headingLevel?: "h2" | "h3";
  showPreview? : boolean;
}

const { showPreview = true } = Astro.props;
const { posts, startIndex = 0, headingLevel = "h2" } = Astro.props;
const Heading = headingLevel;
---

{
	posts.map((p, idx) => (
		<a
			class="post"
			data-astro-prefetch
			href={getPostHref(p)}
			style={`--i: ${startIndex + idx}`}
		>
			<div class="post-rail">
				<time class="post-date" datetime={getPostSortDate(p).toISOString()}>
					{formatRailDate(getPostSortDate(p))}
				</time>
				<span class="post-dot" aria-hidden="true" />
			</div>
			<div class="post-body">
				<Heading class="post-title">
					{p.data.title}
					{p.data.externalUrl && <ExternalIcon />}
        </Heading>
        {showPreview ? (
    <p class="post-preview">{p.data.description}</p>
    ) : (
        p.data.tags?.length > 0 && (
            <div class="post-tags">
                {p.data.tags.map((tag, i) => (
                    <Fragment>
                        {i > 0 && <span class="sep">·</span>}
                        <span class="tag">{tag}</span>
                    </Fragment>
                ))}
            </div>
        )
        )}
			</div>
		</a>
	))
}

<style>
.post-tags {
    margin-top: 6px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;

    font-family: var(--font-mono);
    font-size: 11.5px;
    line-height: 1.6;
    color: hsl(var(--theme-text-muted));
}

.post-tags .sep {
    margin: 0 8px;
    color: hsl(var(--theme-text-muted) / 0.5);
}
</style>
