---
import { getEntry } from "astro:content";
import { type TimelineEntry, timeline } from "@/data/experience";
import PageLayout from "@/layouts/Base.astro";
import { siteConfig } from "@/site-config";
import { absoluteUrl } from "@/utils/path";
import { Schema } from "astro-seo-schema";

const entry = await getEntry("page", "about");

const profile = siteConfig.profile;
const authorName = profile?.name ?? siteConfig.author;

const meta = {
	description: entry?.data.description ?? `${authorName}: education and experience.`,
	title: entry?.data.title ?? "About",
};

const personSameAs = [
	profile?.linkedin,
	profile?.github,
	profile?.twitter,
	profile?.mastodon,
].filter((s): s is string => Boolean(s));

const avatarUrl = profile?.avatar ? absoluteUrl(profile.avatar, Astro.site) : undefined;

/* ---------- Layout maths ---------- */
const OPEN = "9999-12";
const now = new Date().toISOString().slice(0, 7);
const monthFmt = new Intl.DateTimeFormat("en-US", { month: "short", year: "numeric", timeZone: "UTC" });
const fmt = (ym: string) => monthFmt.format(new Date(`${ym}-01T00:00:00Z`));
const endLabel = (e: TimelineEntry) =>
	e.to ? `${fmt(e.to)}${e.expected ? " (expected)" : ""}` : "present";
const isCurrent = (e: TimelineEntry) => (e.to ?? OPEN) >= now && e.from <= now;

const byNewest = (a: TimelineEntry, b: TimelineEntry) => b.from.localeCompare(a.from);
const experience = timeline.filter((e) => e.kind !== "study").sort(byNewest);
const education = timeline.filter((e) => e.kind === "study").sort(byNewest);

// Row 1 holds the column labels; experience entries take one row each from row 2.
const FIRST = 2;
let extraRows = 0;
const educationRows = education.map((e) => {
	const overlaps = experience
		.map((x, i) => ({ x, i }))
		.filter(({ x }) => x.from <= (e.to ?? OPEN) && (x.to ?? OPEN) >= e.from)
		.map(({ i }) => i);
	if (overlaps.length === 0) {
		const row = FIRST + experience.length + extraRows++;
		return { e, start: row, end: row + 1 };
	}
	return {
		e,
		start: FIRST + Math.min(...overlaps),
		end: FIRST + Math.max(...overlaps) + 1,
	};
});
const lastRow = FIRST + experience.length + extraRows;
---

<PageLayout meta={meta}>
	<Schema
		slot="head"
		item={{
			"@context": "https://schema.org",
			"@type": "ProfilePage",
			mainEntity: {
				"@type": "Person",
				name: authorName,
				...(avatarUrl ? { image: avatarUrl } : {}),
				...(education[0]
					? { alumniOf: { "@type": "CollegeOrUniversity", name: education[0].org } }
					: {}),
				...(personSameAs.length ? { sameAs: personSameAs } : {}),
			},
		}}
	/>
	<section class="journey" aria-label="Education and experience">
		<div class="cv" style={`--last-row: ${lastRow}`}>
			<h2 class="section-label lane-label lane-edu" id="edu-label">Education</h2>
			<h2 class="section-label lane-label lane-exp" id="exp-label">Experience</h2>

			<div class="spine" aria-hidden="true"></div>

			<ol class="lane lane-exp-list" aria-labelledby="exp-label">
				{
					experience.map((e, idx) => (
						<li
							class:list={["cv-item", "exp", { current: isCurrent(e) }]}
							style={`grid-row: ${FIRST + idx}; --i: ${idx + 1}`}
						>
							<span class="cv-mark" aria-hidden="true" />
							<p class="cv-dates">
								<time datetime={e.from}>{fmt(e.from)}</time>
								<span aria-hidden="true"> → </span>
								<span class="sr-only"> to </span>
								{e.to ? <time datetime={e.to}>{endLabel(e)}</time> : "present"}
							</p>
							<h3 class="cv-org">{e.org}</h3>
							<p class="cv-role">{e.role}</p>
							{e.summary && <p class="cv-summary">{e.summary}</p>}
							{e.stack && e.stack.length > 0 && (
								<p class="cv-stack">
									{e.stack.map((s, i) => (
										<Fragment>
											{i > 0 && <span class="sep" aria-hidden="true">·</span>}
											<span>{s}</span>
										</Fragment>
									))}
								</p>
							)}
						</li>
					))
				}
			</ol>

			<ol class="lane lane-edu-list" aria-labelledby="edu-label">
				{
					educationRows.map(({ e, start, end }, idx) => (
						<li
							class:list={["cv-item", "edu", { current: isCurrent(e) }]}
							style={`grid-row: ${start} / ${end}; --i: ${idx + 1}`}
						>
							<span class="cv-span" aria-hidden="true" />
							<span class="cv-mark" aria-hidden="true" />
							<p class="cv-dates">
								<time datetime={e.from}>{fmt(e.from)}</time>
								<span aria-hidden="true"> → </span>
								<span class="sr-only"> to </span>
								{e.to ? <time datetime={e.to}>{endLabel(e)}</time> : "present"}
							</p>
							<h3 class="cv-org">{e.org}</h3>
							<p class="cv-role">{e.role}</p>
							{e.summary && <p class="cv-summary">{e.summary}</p>}
						</li>
					))
				}
			</ol>
		</div>
	</section>
</PageLayout>

<style>
	.journey {
		margin-bottom: 88px;
	}

	/*
	 * Two lanes around a shared spine: education left, experience right.
	 * Rows run newest → oldest; an education entry spans every row it overlaps,
	 * drawn as a solid segment on the spine.
	 */
	.cv {
		--gutter: 56px;
		--mark: 9px;
		display: grid;
		grid-template-columns: minmax(0, 0.8fr) var(--gutter) minmax(0, 1.2fr);
		grid-auto-rows: auto;
	}
	.lane {
		display: contents;
		list-style: none;
	}

	.lane-label {
		grid-row: 1;
		margin: 0 0 30px;
		font-weight: 500;
	}
	.lane-edu {
		grid-column: 1;
		text-align: right;
	}
	.lane-exp {
		grid-column: 3;
	}

	.spine {
		grid-column: 2;
		grid-row: 2 / var(--last-row);
		justify-self: center;
		width: 1px;
		margin: 8px 0;
		background: var(--hairline);
		transition: background-color 0.35s ease;
	}

	.cv-item {
		position: relative;
		margin: 0;
		min-width: 0;
	}
	.exp {
		grid-column: 3;
		padding-bottom: 48px;
	}
	.exp:last-child {
		padding-bottom: 0;
	}
	.edu {
		grid-column: 1;
		text-align: right;
		display: flex;
		flex-direction: column;
		align-items: flex-end;
	}

	/* Markers on the spine: circle = experience, diamond = education; filled while ongoing. */
	.cv-mark {
		position: absolute;
		top: calc(0.7em + 1px);
		width: var(--mark);
		height: var(--mark);
		transform: translateY(-50%);
		border-radius: 50%;
		background: hsl(var(--theme-bg));
		border: 1.5px solid var(--faint);
		box-shadow: 0 0 0 3px hsl(var(--theme-bg));
		transition: background-color 0.25s ease, border-color 0.25s ease;
		z-index: 2;
		font-size: 11.5px;
	}
	.exp .cv-mark {
		left: calc(-0.5 * var(--gutter) - 0.5 * var(--mark));
	}
	.edu .cv-mark {
		right: calc(-0.5 * var(--gutter) - 0.5 * var(--mark));
		border-radius: 1px;
		transform: translateY(-50%) rotate(45deg);
		--mark: 8px;
	}
	.current .cv-mark {
		background: hsl(var(--theme-text));
		border-color: hsl(var(--theme-text));
	}
	.cv-item:hover .cv-mark {
		background: hsl(var(--theme-accent));
		border-color: hsl(var(--theme-accent));
	}

	/* The degree's duration, laid over the spine. */
	.cv-span {
		position: absolute;
		right: calc(-0.5 * var(--gutter) - 1.5px);
		top: 10px;
		bottom: 10px;
		width: 3px;
		border-radius: 2px;
		background: hsl(var(--theme-text) / 0.28);
		z-index: 1;
		transition: background-color 0.25s ease;
	}
	.edu:hover .cv-span {
		background: hsl(var(--theme-accent) / 0.6);
	}

	.cv-dates {
		font-family: var(--font-mono);
		font-size: 11.5px;
		line-height: 1.4;
		font-weight: 500;
		color: hsl(var(--theme-text) / 0.8);
		white-space: nowrap;
		font-variant-numeric: tabular-nums;
		margin: 0 0 6px;
		padding-top: 1px;
	}
	.cv-org {
		font-family: var(--font-display);
		font-weight: 500;
		font-size: 23px;
		line-height: 1.25;
		letter-spacing: -0.012em;
		color: hsl(var(--theme-text));
		margin: 0;
		text-wrap: balance;
		transition: color 0.2s ease;
	}
	.cv-item:hover .cv-org {
		color: hsl(var(--theme-accent));
	}
	.cv-role {
		font-family: var(--font-serif);
		font-style: italic;
		font-size: 17px;
		line-height: 1.45;
		color: hsl(var(--theme-text-muted));
		margin: 2px 0 0;
		text-wrap: balance;
	}
	.cv-summary {
		font-family: var(--font-serif);
		font-size: 16px;
		line-height: 1.6;
		color: hsl(var(--theme-text) / 0.85);
		margin: 10px 0 0;
		text-wrap: pretty;
	}
	.cv-stack {
		font-family: var(--font-mono);
		font-size: 11.5px;
		line-height: 1.6;
		color: hsl(var(--theme-text-muted));
		margin: 10px 0 0;
		display: flex;
		flex-wrap: wrap;
	}
	.cv-stack .sep {
		margin: 0 8px;
		color: var(--faint);
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}

	@media (prefers-reduced-motion: no-preference) {
		.cv-item {
			animation: intro-fade-up 380ms cubic-bezier(0.2, 0.6, 0.2, 1) both;
			animation-delay: calc(var(--i, 0) * 70ms);
		}
	}

	/* Narrow: one lane with a rail on the left; experience first, then education. */
	@media (max-width: 720px) {
		.cv {
			--gutter: 22px;
			grid-template-columns: minmax(0, 1fr);
			padding-left: var(--gutter);
		}
		.spine,
		.cv-span {
			display: none;
		}
		.lane-label,
		.cv-item {
			grid-column: 1 !important;
			grid-row: auto !important;
			text-align: left;
		}
		.lane-exp { order: 1; }
		.exp { order: 2; }
		.lane-edu { order: 3; margin-top: 52px; }
		.edu { order: 4; }

		.lane-label {
			margin-bottom: 24px;
		}
		.cv-item {
			padding-bottom: 36px;
		}
		.exp:last-of-type {
			padding-bottom: 0;
		}
		.cv-item::before {
			content: "";
			position: absolute;
			left: calc(-1 * var(--gutter) + 4px);
			top: 8px;
			bottom: 0;
			width: 1px;
			background: var(--hairline);
		}
		.exp:last-of-type::before,
		.edu:last-of-type::before {
			bottom: 8px;
		}
		.exp .cv-mark,
		.edu .cv-mark {
			left: calc(-1 * var(--gutter) + 4.5px - 0.5 * var(--mark));
			right: auto;
		}
		.edu {
			display: block;
		}
	}
	@media (max-width: 420px) {
		.cv-org {
			font-size: 19px;
		}
		.cv-role {
			font-size: 16px;
		}
		.cv-summary {
			font-size: 15px;
		}
	}
</style>
